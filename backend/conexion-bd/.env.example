# COPIAR los hosts exactos de Connect en Supabase; nunca inventar región/host.
# Runtime: usuario transporte_app.<nfquazmtoqwypigdhrus>, Session pooler puerto5432.
DATABASE_URL="postgresql://transporte_app.nfquazmtoqwypigdhrus:PASSWORD_URL_ENCODED@aws-1-us-west-2.pooler.supabase.com:5432/postgres"
# Solo herramientas/alta inicial: usuario postgres.<nfquazmtoqwypigdhrus> u otro migrador autorizado.
DIRECT_URL="postgresql://postgres.nfquazmtoqwypigdhrus:MIGRATOR_PASSWORD_URL_ENCODED@aws-1-us-west-2.pooler.supabase.com:5432/postgres?schema=transporte&sslmode=require"
DB_SSL="true"
# Si tu conexión exige certificado, descarga la CA desde tu proyecto y especifica su ruta.
# El runtime siempre verifica el certificado y nombre del servidor.
DB_SSL_CA_FILE=""
# Para Prisma CLI añadir sslcert=<ruta_URL_encoded> a DIRECT_URL si hace falta la CA.
# Solo durante bootstrap de un administrador REAL. No hay cuenta/password predeterminados.
ADMIN_EMAIL=""
ADMIN_NOMBRES=""
ADMIN_APELLIDOS=""
ADMIN_TIPO_DOCUMENTO="CEDULA"
ADMIN_DOCUMENTO=""
# ADMIN_PASSWORD se proporciona temporalmente por variable de entorno, no en el ZIP.
