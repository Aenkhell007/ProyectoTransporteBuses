  sha256             String               @db.Char(64)
  validado_servidor  Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  cooperativas       cooperativas?        @relation(fields: [cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios           usuarios             @relation(fields: [propietario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  boletos            boletos[]
  bus_fotos          bus_fotos[]
  comprobantes       comprobantes?
  config_cooperativa config_cooperativa[]
  cuentas_bancarias  cuentas_bancarias[]
  exportaciones      exportaciones[]
