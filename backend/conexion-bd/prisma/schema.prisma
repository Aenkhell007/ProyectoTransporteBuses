generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["transporte"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model abordajes {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativa_id     String           @db.Uuid
  compra_id          String           @db.Uuid
  reserva_asiento_id String           @unique @db.Uuid
  operador_id        String           @db.Uuid
  escaneado_at       DateTime         @default(now()) @db.Timestamptz(6)
  clave_intento      String           @unique @db.VarChar(120)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @db.Timestamptz(6)
  compras            compras          @relation(fields: [cooperativa_id, compra_id], references: [cooperativa_id, id], onDelete: NoAction, onUpdate: NoAction)
  cooperativas       cooperativas     @relation(fields: [cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reserva_asientos   reserva_asientos @relation(fields: [cooperativa_id, reserva_asiento_id], references: [cooperativa_id, id], onDelete: NoAction, onUpdate: NoAction)
  usuarios           usuarios         @relation(fields: [operador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cooperativa_id, id])
  @@unique([cooperativa_id, reserva_asiento_id])
  @@index([cooperativa_id], map: "abordajes_coop_idx")
  @@schema("transporte")
}

