datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Cooperative {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model User {
  id            Int          @id @default(autoincrement())
  nombres       String?
  apellidos     String?
  email         String       @unique
  password      String       // Campo requerido para Auth
  role          String       @default("Cliente")
  cooperativeId Int?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])
}
