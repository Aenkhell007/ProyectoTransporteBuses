# Configuración privada; las URL de base se pueden definir en conexion-bd/.env.
PORT=3000
FRONTEND_URL=http://127.0.0.1:5173
# DATABASE_URL usa el rol de aplicación. DIRECT_URL solo para migraciones.
# DB_SSL_CA_FILE=certs/supabase-ca.crt
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Gran Continental

# Activación explícita: no se envían boletos mientras estos valores estén vacíos/false.
# Fecha ISO con zona desde la que se permite consumir la cola (evita envíos históricos).
BOLETOS_DESDE=
BOLETOS_EMAIL_ACTIVO=false
BOLETOS_WHATSAPP_ACTIVO=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
# Plantilla aprobada: cabecera Documento + una variable de cuerpo para código de compra.
WHATSAPP_TEMPLATE_BOLETO=
WHATSAPP_TEMPLATE_IDIOMA=es

# Pasarela PayPhone (credenciales del portal PayPhone Developers; el token nunca sale al navegador).
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_RESPONSE_URL=http://127.0.0.1:5173/pago/payphone/respuesta
PAYPHONE_CANCELLATION_URL=http://127.0.0.1:5173/pago

# Opcional: ID privado y estable del backend que conserva los archivos del boleto.
# Si se omite se deriva del equipo y carpeta; no compartas el mismo ID entre almacenes distintos.
BACKEND_ID=

# PayPhone (configurar solo en el entorno correspondiente)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_RESPONSE_URL=http://127.0.0.1:5173/pago/payphone/respuesta
PAYPHONE_CANCELLATION_URL=http://127.0.0.1:5173/pago

# Google Wallet. Configura el emisor y una cuenta de servicio en el servidor.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Google Wallet API gratuita para boletos en Android (ver docs/google-wallet-android.md).
# Puedes usar archivo JSON (GOOGLE_APPLICATION_CREDENTIALS) o GOOGLE_WALLET_PRIVATE_KEY inline.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_PROJECT_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-wallet.json
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=gran_continental_bus_v1
GOOGLE_WALLET_ORIGINS=
GOOGLE_WALLET_LOGO_URL=
