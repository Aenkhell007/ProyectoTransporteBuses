# Variables privadas de runtime para Docker (NUNCA versionar .env.docker ni incluir DIRECT_URL/ADMIN_*).
# Copia este archivo a .env.docker y completa los valores necesarios.

# Conexión limitada a PostgreSQL (rol runtime limitado en Supabase, sin DIRECT_URL)
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
# Si el proveedor requiere una CA específica, coloca aquí su ruta dentro del contenedor.
DB_SSL_CA_FILE=
PG_POOL_MAX=5

# Origen HTTP/HTTPS desde donde se abre el frontend
FRONTEND_URL=http://127.0.0.1:5173
# Orígenes adicionales separados por coma (opcional, p. ej. URL HTTPS de defensa o dominio propio)
EXTRA_ORIGINS=

# Identificador estable del almacén de boletos en Docker
BACKEND_ID=gran-continental-docker-principal

# Correo (Brevo) y entregas automáticas desactivadas por seguridad en demostración local
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Gran Continental
BIENVENIDAS_EMAIL_ACTIVO=false
BOLETOS_EMAIL_ACTIVO=false
BOLETOS_WHATSAPP_ACTIVO=false
BOLETOS_DESDE=

# Pasarela PayPhone (credenciales de desarrollador)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_RESPONSE_URL=http://127.0.0.1:5173/pago/payphone/respuesta
PAYPHONE_CANCELLATION_URL=http://127.0.0.1:5173/pago

# Google Wallet API para Android (gratuita; admite archivo JSON en /run/secrets o clave inline)
# Guía paso a paso: docs/google-wallet-android.md
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_PROJECT_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=gran_continental_bus_v1
GOOGLE_WALLET_ORIGINS=
GOOGLE_WALLET_LOGO_URL=
